{
  "manifest_version": 3,
  "name": "Agent Autofill",
  "version": "0.2.0",
  "description": "Fills user-approved vault logins into pages on request from the local agent-autofill tool. Secrets never pass through the AI agent.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["nativeMessaging", "scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"]
}
