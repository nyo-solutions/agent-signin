# Machine-local settings for the agent-vault scripts.
# Copy to local.env (gitignored) and fill in. Sourced by env.sh and aws/lib.sh.
VAULT_DOMAIN=vault.example.com          # public hostname of your vault
ZONE_NAME=example.com                   # Route 53 public hosted zone that contains it
GITHUB_REPO=your-org/your-vault-ops     # private repo whose Actions may deploy (aws/setup-github.sh)
