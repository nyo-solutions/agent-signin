#!/bin/bash
# MCP launcher used by Claude Desktop. Pulls BW_SESSION from the macOS
# Keychain at start-up so the session key never sits in a config file.
source "$(dirname "$0")/../env.sh"
export BW_CLI_PATH="$BW_BIN"
if s=$(security find-generic-password -s "$KC_SERVICE" -a "$USER" -w 2>/dev/null); then
  export BW_SESSION="$s"
else
  echo "agent-vault: no BW_SESSION in Keychain; run refresh-agent-session.sh" >&2
fi
exec npx -y "$MCP_PKG"
